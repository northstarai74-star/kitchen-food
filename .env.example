# Recipes use local Ollama by default (run: ollama serve, ollama pull llama3.2)
USE_LOCAL_MODEL=true
OLLAMA_MODEL=llama3.2
# OLLAMA_PORT=11434
# On battery the laptop GPU throttles (~7 tok/s); CPU is faster then (~13). Uncomment to force CPU:
# OLLAMA_NUM_GPU=0

# Only needed if USE_LOCAL_MODEL=false
ANTHROPIC_API_KEY=
# PORT=5500
